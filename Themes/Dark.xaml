<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BackgroundColor">#FF1C1C1C</Color>
    <Color x:Key="SidebarColor">#FF141414</Color>
    <Color x:Key="SidebarBorderColor">#FF2A2A2A</Color>
    <Color x:Key="NavHoverColor">#FF2A2A2A</Color>
    <Color x:Key="NavActiveColor">#FF333333</Color>
    <Color x:Key="TextPrimaryColor">#FFE0E0E0</Color>
    <Color x:Key="TextSecondaryColor">#FF909090</Color>
    <Color x:Key="AccentColor">#FF5B9BD5</Color>
    <Color x:Key="ToggleTrackOffColor">#FF444444</Color>
    <Color x:Key="ToggleThumbColor">#FFE0E0E0</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="{StaticResource SidebarBorderColor}"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="{StaticResource NavHoverColor}"/>
    <SolidColorBrush x:Key="NavActiveBrush" Color="{StaticResource NavActiveColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="{StaticResource ToggleTrackOffColor}"/>
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="{StaticResource ToggleThumbColor}"/>

</ResourceDictionary>
