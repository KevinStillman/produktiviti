<Window x:Class="produKtiviti.Views.RoboMouseConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoboMouse - Configure"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SidebarBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource SidebarBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,24,28,24">

        <!-- Start Key -->
        <TextBlock Text="START KEY" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="StartKeyBox"
                 Margin="0,0,0,16"
                 IsReadOnly="True"
                 PreviewKeyDown="KeyBox_PreviewKeyDown"
                 GotFocus="KeyBox_GotFocus"
                 LostFocus="KeyBox_LostFocus"
                 ToolTip="Click then press any key"/>

        <!-- Stop Key -->
        <TextBlock Text="STOP KEY" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="StopKeyBox"
                 Margin="0,0,0,16"
                 IsReadOnly="True"
                 PreviewKeyDown="KeyBox_PreviewKeyDown"
                 GotFocus="KeyBox_GotFocus"
                 LostFocus="KeyBox_LostFocus"
                 ToolTip="Click then press any key"/>

        <!-- Click Interval -->
        <TextBlock Text="CLICK INTERVAL (ms)" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="IntervalBox"
                 Margin="0,0,0,8"/>

        <!-- Randomize -->
        <CheckBox x:Name="RandomizeCheck"
                  Content="Randomize interval"
                  Margin="0,0,0,8"
                  Checked="RandomizeCheck_Changed"
                  Unchecked="RandomizeCheck_Changed"/>

        <Grid x:Name="RandomPanel" Margin="0,0,0,16" IsEnabled="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="MIN (ms)" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="RandomMinBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="MAX (ms)" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="RandomMaxBox"/>
            </StackPanel>
        </Grid>

        <!-- Mouse Button -->
        <TextBlock Text="MOUSE BUTTON" Style="{StaticResource LabelStyle}"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
            <RadioButton x:Name="LeftButton" Content="Left" IsChecked="True"/>
            <RadioButton x:Name="RightButton" Content="Right"/>
        </StackPanel>

        <!-- Validation message -->
        <TextBlock x:Name="ValidationText"
                   Foreground="#FF6B6B"
                   FontSize="12"
                   Margin="0,0,0,12"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Style="{StaticResource CancelButton}"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>
            <Button Content="Save"
                    Style="{StaticResource ActionButton}"
                    Click="Save_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
