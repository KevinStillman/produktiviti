<UserControl x:Class="produKtiviti.Views.Controls.SoftwareRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="340"
             Margin="0,0,12,12">

    <UserControl.Resources>
        <Style x:Key="RowProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ToggleTrackOffBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsIndeterminate" Value="True"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource SidebarBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="SelectBox"
                      Grid.Column="0"
                      VerticalAlignment="Top"
                      Margin="0,2,10,0"
                      Checked="SelectBox_Checked"
                      Unchecked="SelectBox_Unchecked"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="NameText"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14"
                           FontWeight="Medium"/>
                <TextBlock x:Name="DescriptionText"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
                <ProgressBar x:Name="RowProgress"
                             Style="{StaticResource RowProgressBar}"
                             Margin="0,8,0,0"
                             Visibility="Collapsed"/>
            </StackPanel>

            <TextBlock x:Name="StatusText"
                       Grid.Column="2"
                       FontSize="11"
                       FontWeight="SemiBold"
                       VerticalAlignment="Top"
                       Margin="8,2,0,0"
                       Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>
