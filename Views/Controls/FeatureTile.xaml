<UserControl x:Class="produKtiviti.Views.Controls.FeatureTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="160"
             Height="180"
             Margin="10">

    <UserControl.Resources>
        <!-- Star/favorite button -->
        <Style x:Key="StarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <TextBlock x:Name="star"
                                       Text="&#9734;"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Three-dot button -->
        <Style x:Key="ThreeDotButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Context menu item style — no icon column -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SidebarBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="12,6">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="TileBorder"
            Background="{DynamicResource SidebarBrush}"
            CornerRadius="10"
            Cursor="Hand"
            MouseLeftButtonUp="Tile_Click">

        <Border.ToolTip>
            <ToolTip Background="{DynamicResource SidebarBrush}"
                     BorderBrush="{DynamicResource SidebarBorderBrush}"
                     BorderThickness="1"
                     Padding="10,8"
                     HasDropShadow="True"
                     Placement="Mouse">
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"
                           MaxWidth="200"
                           TextWrapping="Wrap"/>
            </ToolTip>
        </Border.ToolTip>

        <Border.Effect>
            <DropShadowEffect BlurRadius="8"
                              ShadowDepth="2"
                              Opacity="0.15"
                              Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar: star (left) + three-dot menu (right) -->
            <Grid Grid.Row="0" Margin="6,6,6,0">
                <Button x:Name="FavoriteButton"
                        Style="{StaticResource StarButton}"
                        HorizontalAlignment="Left"
                        Click="FavoriteButton_Click"/>
                <Button x:Name="MenuButton"
                        Style="{StaticResource ThreeDotButton}"
                        HorizontalAlignment="Right"
                        Content="..."
                        Click="MenuButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="TileContextMenu"
                                         Background="{DynamicResource SidebarBrush}"
                                         BorderBrush="{DynamicResource SidebarBorderBrush}">
                                <MenuItem Header="Configure"
                                          Click="Configure_Click"/>
                            </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>

            <!-- Icon + Name -->
            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <Image x:Name="FeatureIcon"
                       Width="64"
                       Height="64"
                       Stretch="Uniform"
                       Margin="0,0,0,10"/>
                <TextBlock x:Name="FeatureName"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="13"
                           FontWeight="Medium"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Status badges (only one visible at a time) -->
            <Border Grid.Row="2"
                    x:Name="EnabledBadge"
                    Visibility="Collapsed"
                    Background="Transparent"
                    Margin="0,0,0,10">
                <TextBlock Text="Enabled"
                           Foreground="#4CAF50"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </Border>

            <Border Grid.Row="2"
                    x:Name="SetupRequiredBadge"
                    Visibility="Collapsed"
                    Background="Transparent"
                    Margin="0,0,0,10">
                <TextBlock Text="Setup Required"
                           Foreground="#FF9800"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Spacer when no badge shown -->
            <Border Grid.Row="2"
                    x:Name="DisabledSpacer"
                    Visibility="Visible"
                    Height="22"
                    Margin="0,0,0,10"/>

        </Grid>
    </Border>
</UserControl>
