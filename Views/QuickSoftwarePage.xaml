<UserControl x:Class="produKtiviti.Views.QuickSoftwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InstallActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelActionButton" TargetType="Button" BasedOn="{StaticResource InstallActionButton}">
            <Setter Property="Background" Value="{DynamicResource SidebarBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="OverallProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ToggleTrackOffBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,40,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="Quick Software"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="28"
                       FontWeight="Light"/>
            <TextBlock Text="Pick what you want on a fresh PC, then install it all in one go. Windows may prompt for permission during some installs."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,20,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Select All" Style="{StaticResource LinkButton}" Click="SelectAll_Click" Margin="0,0,16,0"/>
                <Button Content="Select None" Style="{StaticResource LinkButton}" Click="SelectNone_Click"/>
            </StackPanel>

            <TextBlock x:Name="ProgressText"
                       Grid.Column="1"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- Overall progress -->
        <ProgressBar x:Name="OverallProgress"
                     Grid.Row="2"
                     Style="{StaticResource OverallProgressBarStyle}"
                     Margin="0,0,0,16"
                     Minimum="0"
                     Visibility="Collapsed"/>

        <!-- Software list -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="SoftwareList" Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- Log -->
        <Border x:Name="LogPanel"
                Grid.Row="4"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,12,0,0"
                Padding="10"
                Visibility="Collapsed">
            <ScrollViewer Height="110" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="LogBox"
                         Background="Transparent"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="11"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"/>
            </ScrollViewer>
        </Border>

        <!-- Action bar -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="WingetWarning"
                           Text="winget (App Installer) wasn't found on this PC yet — it's usually added automatically once Windows finishes its first-time setup and connects to the internet."
                           Foreground="#FF9800"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
                <StackPanel x:Name="WingetActions"
                            Orientation="Horizontal"
                            Margin="0,4,0,0"
                            Visibility="Collapsed">
                    <Button Content="Open Microsoft Store" Style="{StaticResource LinkButton}" Click="OpenStore_Click" Margin="0,0,16,0"/>
                    <Button Content="Check again" Style="{StaticResource LinkButton}" Click="CheckAgain_Click"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Style="{StaticResource CancelActionButton}"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"
                        Visibility="Collapsed"/>
                <Button x:Name="InstallButton"
                        Content="Download and Install"
                        Style="{StaticResource InstallActionButton}"
                        Click="InstallButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
